# Auth is Keboola's own OIDC gate (data app access mode = OIDC, Entra ID) —
# configured in the Keboola UI on the "GM Client Report" data app itself
# (config 01m0zqrcn3jhaa4dbrzb028xkv), not via env vars here. This app's code
# only reads the X-Kbc-User-Email header Keboola's proxy sets — nothing to
# configure locally for auth.

# Keboola Storage Access / Query Service — read+write access to the tables
# added under this data app's Advanced Settings > Storage Access:
#   out.c-BDM.BI_PROPERTY_FINANCIALS_BVA, out.c-BDM.DIM_MASTER_PROPERTY,
#   out.c-Data-App-Access-Security.DATA_APP_ACCESS (read),
#   in.c-APP_STORAGE.GM_COMMENTARY (read+write)
# Injected automatically by Keboola at deploy time when Storage Access is
# enabled — do not set these manually in production. Only needed here if
# testing server/ locally against real data (values would need to come from
# a real deployed run, since the workspace is ephemeral and created per-start).
QUERY_SERVICE_URL=
WORKSPACE_ID=
KBC_URL=
KBC_TOKEN=

PORT=8080
